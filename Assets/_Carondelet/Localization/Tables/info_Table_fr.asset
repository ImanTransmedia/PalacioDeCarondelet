  - m_Id: 6903966347845666
    m_Localized: "Anonyme\nSculpture taill\xE9e en bois et polychrome\nXVIIIe si\xE8cle\nCollection
      du Mus\xE9e National, Minist\xE8re de l\u2019\xC9ducation, \ndu Sport et de
      la Culture"
    m_Metadata:
