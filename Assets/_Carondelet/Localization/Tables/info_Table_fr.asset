  - m_Id: 6903966347845667
    m_Localized: "<b>Vierge avec l\u2019enfant</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845668
    m_Localized: "Anonyme\nHuile sur toile\nXIXe si\xE8cle\nCollection du Mus\xE9e
      National, Minist\xE8re de l\u2019\xC9ducation, \ndu Sport et de la Culture"
    m_Metadata:
