  m_LocaleId:
    m_Code: es-EC
  m_SharedData: {fileID: 11400000, guid: e6909cd5edeaea74aab924612974dffc, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 300936355840
    m_Localized: Kapakapukpa Wasi
    m_Metadata:
      m_Items: []
  - m_Id: 301066379264
    m_Localized: "Real Hatun Wasi shutirishkakunaka, Real Audiencia Quito llaktapa
      ukuka, Corona espa\xF1ola Apukkunapa 1563 waranka pichka patsak sukta chunka
      kimsa watapimi wacharirka, Kay ukupika kawsaytaka 1612 waranka sukta patsak
      chunka ishkay watapimi kawsayta kallarirka. Kay XVIII chawpi chunka pusak patsakwatapika
      chay wasikunataka urmachirka, kipamanka kay samana kuska chimpapika, shuk allpakunata
      tantachishpa mushuk hatun wasitami shayachirka. Kishpirishka puncha kipamantaka,
      republicano Kapakapukpami wasi tukurka.\n\n1970 Waranka iskun patsak kanchis
      chunka watamantami Palacio de Carondelet shutiwan riksirishka kan, ashtawanpacha
      Luis Francisco H\xE9ctor Bar\xF3n de Carondelet, ishkay chunka iskun Real Audienciapa
      \xF1awpakman pushak, shinallatak 1799 waranka kanchis patsak iskun chunka iskun
      watamanta, 1807 waranka pusak patsak kanchis watakaman mamallaktata \xF1awpakman
      pusharka, chaymantami pay taytata yuyarishpami kay Hatun wasika chay shutiwan
      riksirishka kan\n\nKay 1956 waranka iskun patsak pichka chunka sukta watamanta
      shinallatak 1960 waranka iskun patsak sukta chunka watakaman, Doctor Camilo
      Ponce Enr\xEDquez Kapakapukpa pachapika, kay wasitaka mushukyachirkakuna, chay
      kashkamantami kunan riksikripanchik.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 301066379265
    m_Localized: Rikchashka
    m_Metadata:
      m_Items: []
  - m_Id: 301066379266
    m_Localized: "\xD1awpa mushuk rikchashkaka republicana kallariy mushukyachishkami
      rikurin. \n1843 waranka pusak patsak chusku chunka kimsa watapi Francia mamallaktamanta
      Teodoro Lavezzari wasirurayachak taytami paktachishka. \nGeneral Jos\xE9 Mar\xEDa
      Urvina Kapakapuk pachapi, 1851 waranka pusak patsak pichka chunka shuk  watamanta
      1856 waranka pusak patsak pichka chunka sukta watakaman pullkanka unanchatami
      churarkakuna."
    m_Metadata:
      m_Items: []
  - m_Id: 301070573568
    m_Localized: Uchilla wasikukuna
    m_Metadata:
      m_Items: []
  - m_Id: 301070573569
    m_Localized: 'Kay hatun Wasi sapipika, chunka uchilla wasikukunami paskarin,
      kay ukukunapika katuna kuskakukunami shuk shuk katunakunatami katunkuna. '
    m_Metadata:
      m_Items: []
  - m_Id: 301070573570
    m_Localized: Andesita Rumi
    m_Metadata:
      m_Items: []
  - m_Id: 301070573571
    m_Localized: "Kay Hatun Wasipika, wakin rumikunaka \xF1awpa Inka wasikunapash
      kankunami nin, shinapash mana yacharinchu shina kaktaka."
    m_Metadata:
      m_Items: []
  - m_Id: 301070573572
    m_Localized: Ankas Unancha
    m_Metadata:
      m_Items: []
  - m_Id: 301070573573
    m_Localized: "Kay ishkay waranka ishkay chunka chusku watapi, pichka punchapi,
      ayriway killapimi, kay Chile \xF1anpi shinallatak Garc\xEDa Moreno \xF1an kuchupi,
      shuk ankas unanchatami churashkakuna shinallatak kay hatun Wasi yaykunapipash,
      chaymantami Bien Patrimonial Intangible nishkapi riksirishkakuna, ashtawanpacha
      ukumanta shinallatak kanchamanta hatun makanakuypi wakaychinkapak (Convenci\xF3n
      de la Haya de 1954 \u2013 Haya tantanakuypi wacharishka kay waranka iskun patsak
      pichka chunka chusku watapi)."
    m_Metadata:
      m_Items: []
  - m_Id: 301070573574
    m_Localized: Tuni
    m_Metadata:
      m_Items: []
  - m_Id: 301070573575
    m_Localized: Kay hatun kapakapukpa wasika Tawka Tunikunatami charin, 1960 waranka
      iskun patsak sukta chunka watapimi kay tunikunataka mushukyachiskakuna. Kallariy
      tunikunataka 1845 waranka pusak patsak chusku chunka pichka watapimi hatarichishkakuna.
    m_Metadata:
      m_Items: []
  - m_Id: 301070573576
    m_Localized: "Abd\xF3n Calder\xF3n placa killkashka yuyariy "
    m_Metadata:
      m_Items: []
  - m_Id: 301070573577
    m_Localized: "Atikruna wawa Abd\xF3n Calder\xF3n Placa killkashka yuyariy, kay
      Pichincha Makanakuypi ishkay chunka chusku punchapi, aymuray killapi, 1822
      waranka pusak patsak ishkay chunka ishkay watapi."
    m_Metadata:
      m_Items: []
  - m_Id: 301070573578
    m_Localized: "L\xE1pidas conmemorativas killkashkakuna"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966259765248
    m_Localized: "Audiencia tantanakuypa kallarishka L\xE1pidas conmemorativas killkashkakuna.
      1612 (ukupi) waranka sukta patsak chunka ishkay wata 1747 (hawapi) waranka
      kanchis patsak chusku chunka kanchis wata."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966339457024
    m_Localized: "Sim\xF3n Bol\xEDvar placa killkashka"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966339457025
    m_Localized: "Sim\xF3n Bol\xEDvar kishpichik Taytapa imashina Quito llaktaman
      chayamushkamanta Placa recordatoria killkashkata riksichin, chunka sukta punchapi,
      Raymi killapi 1822 waranka pusak patsak ishkay chunka ishkay watapi."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966339457026
    m_Localized: 'Harkankapak Hillay '
    m_Metadata:
      m_Items: []
  - m_Id: 6903966339457027
    m_Localized: "Antonio Flores Jij\xF3n, Francia mamallaktapi, Ecuador mamallaktapa
      Ministro taytaka, Par\xEDs llaktapi, Hatun wasipakka shuk katuy rantinakunapimi,
      harkankapak hillaykunata rantishka. Kay harkankapak hillaykunaka Palacio de
      Tuller\xEDas Hatun wasipakmi kashka, kunanpika kay hillaykunaka wakin tunikunatami
      tinkichin."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966339457028
    m_Localized: Granaderos de Tarqui awka runakuna
    m_Metadata:
      m_Items: []
  - m_Id: 6903966339457029
    m_Localized: "Escolta presidencial runakunapa churakushkakunaka, Granaderos de
      Tarqui Awka runakunapa churakushkakuna shinami kan, paykunaka Batalla de Tarqui
      hatun makanakuypimi makanakushkakuna, 1829 waranka pusak patsak ishkay chunka
      iskun watapi Per\xFA mamallaktapa awkakanchakunata mishashkakuna asthawankarin
      Colombia mamallaktapa kullasuyuman yaykushkamanta."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651328
    m_Localized: "<b>Gabriel Garc\xEDa Moreno yuyarinkapak killkashka l\xE1pida</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651329
    m_Localized: "Kay L\xE1pida killkashkaka Gabriel Garc\xEDa Moreno \xD1awpakman
      pushak taytata yuyarinkapakmi, paypa mashikuna iskun chunka watata wa\xF1ushkamantami
      churashkakuna."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651330
    m_Localized: "L\xE1pida killkashkaka Capitulaci\xF3n Espa\xF1ola patsak watata
      yuyarishpami churashkakuna, ashtawanpacha Pichincha makanakuy kipa "
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651331
    m_Localized: "L\xE1pida killkashkaka Capitulaci\xF3n Espa\xF1ola patsak watata
      yuyarishpami churashkakuna, ashtawanpacha Pichincha ishkay chunka chusku aymuray
      killa 1822 waranka pusak patsak ishkay chunka ishkay wata makanakuy kipa. Ninmi:
      \u201CKay kuskapimi 25 ishkay chunka pichka aymuray killa 1822 waranka pusak
      patsak ishkay chunka ishkay watapi, Pichincha makanakuypi mishashkamanta acta
      de capitulaci\xF3n killkashkata warawashka. Sociedad de Sastres tantanakushka.
      Quito llakta, aymuray killa 1922 waranka iskun patsak ishkay chunka ishkay
      wata\u201D."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651332
    m_Localized: "El Bar\xF3n de Carondelet"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651333
    m_Localized: "Bar\xF3n de Carondelet, Real Audiencia de Quito llaktata \xF1awpakman
      pushakka, llaktata \xF1awpakman llukchishkamantami riksirishka kan. Catedral
      Apunchikpa wasimanta shuyu rikchakta llukchishkakuna."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651334
    m_Localized: Yakumamapa llukshik kuska
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651335
    m_Localized: "Camilo Ponce Enr\xEDquez \xD1awpakman pushak pachapika, Kapakapukpa
      wasitaka sumakyachishkakuna. Ishkay hatun wasipampakunata, claustros shinallatak
      arquer\xEDas nishka ukukunatapashmi wi\xF1achirkakuna, shinallatak chawpi wasipampapika
      Yakumamapa llukshik kuskakunatapash wi\xF1achirka ashtawanpacha Ignacio Codena
      tayta llamkashka"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651336
    m_Localized: "Pabell\xF3n Nacional kuska"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651337
    m_Localized: "Tukuylla chayakkunami pabell\xF3n nacional kuskata, sumaychayta
      paktachinkuna."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651338
    m_Localized: Amazonas Mayuta tarishkamanta tullpushka pirka
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651339
    m_Localized: "Kay Tullpushka pirkapika Amazonas mayuta tarishkamantami rikuyta
      ushanchik, kay tarishkakunamanta rikushpaka, Quito llaktamanta 200 ishkay patsak
      espa\xF1olkuna, 3000 kimsa waranka runakunawan Gonzalo Pizarro \xF1awpashpa
      kallarishkakuna, ashtawanpacha urkukunata yallishpa, sachakunaman yaykurkakuna.
      12 chunka ishkay puncha panchi killapi 1542 waranka pichka patsak chusku chunka
      ishkay watapi Francisco de Orellana capit\xE1n taytami R\xEDo Mar mayuman chayarka,
      shinapash mana chaymanta tikrayta ushaymanta Atl\xE1ntico hatun kuchaman wampurka,
      chay kipami kay hatun tarishkamantaka Corona Apukkunaman willachirka. Amazonas
      shutitaka, purikuypi wakin tantanakushka warmi makanakukrunakuna makankapak
      shayarishka ninkuna, chaymantami mitolog\xEDa griega Amazonas nishkamantami
      yuyarishkakuna."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651340
    m_Localized: Piano
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651341
    m_Localized: Piano takikhillayka Kawai shutimi kan. Kaytaka Embajada China mamallaktamanta,
      Ecuador mamallaktaman karashka kay panchi killapi ishkay waranka ishkay chunka
      ishkay watapi.
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651342
    m_Localized: "<b>Sim\xF3n Bol\xEDvar</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651343
    m_Localized: "Marco Salas\n\xD3leo sobre lienzo\nSiglo XX\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651344
    m_Localized: "<b>Antonio Jos\xE9 de Sucre</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651345
    m_Localized: "V\xEDctor Mideros\n\xD3leo sobre lienzo\nSiglo XX\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651346
    m_Localized: <b>Eugenio Espejo</b>
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651347
    m_Localized: "Oswaldo Viteri\n\xD3leo sobre lienzo\nSiglo XX\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651348
    m_Localized: "<b>Manuela S\xE1enz</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651349
    m_Localized: "Oswaldo Viteri\n\xD3leo sobre lienzo\nSiglo XX\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651350
    m_Localized: "R\xE9plica de la escultura de Antonio Jos\xE9 de Sucre"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651351
    m_Localized: "Ashtawanpacha Francia Mamallaktamanta Emmanuele Fontaine kay llakllakamataka
      rurashka. Kaytaka 25 ishkay chunka pichka punchapi, aymuray killapi 1909 waranka
      iskun patsak iskun watapimi kallariy rurayta paktachishkakuna, Sucre llaktapi,
      Bolivia Mamallaktapi. Llaksa, 37 cm. Kimsa chunka kanchis cm. \nKallariy Kuski
      killapi 1975 waranka iskun patsak kanchis chunka pichka watapi, tutamanta pachapimi
      Awka tantanakushka runakunami Kapakapukpa wasita llakichinkapak yaykushka,
      ashtawanpacha dictador Guillermo Rodr\xEDguez Lara taytata urmachinkapak, shinapash
      mana kay llakichiytaka paktachishkakuna. Kay llakikunapimi kay Llakllakamashkataka
      waktashkakuna\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651352
    m_Localized: "Pichka \xD1awpapacha Imakuna"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651353
    m_Localized: "Shuyuwan Puntu \n\nShuyushka Kimsa mikuna mulukuna\n\nKimsa chakiwan
      manka\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651354
    m_Localized: Killkapataku
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651355
    m_Localized: "Kay killkapatakutaka Neptal\xED Mart\xEDnez Jaramillo llakllakamayukmi
      rurashka, paytaka Le\xF3n Febres Cordero \xF1awpakman pushakmi condecoraci\xF3n
      al m\xE9rito en el grado de Oficial nishkata chayachirka waranka iskun patsak
      pusak chunka sukta watapi. Ashtawanpacha kanchaman shinallatak ukumanpash,
      sumak Ecuador mamallaktapa makirurayta \xF1awpakman llukchishkamanta. "
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651356
    m_Localized: Cedro yurawan rurashkakuna
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651357
    m_Localized: "Kay ukupika Artesonado nishkaka, cedro yurawan rurashkakunami rikurin,
      Kay sumak llamkaykunata paktachinkapakka Miguel \xC1ngel, Leonardo Tejada shinallatak
      Luis Villag\xF3mez taytakunami llamkashkakuna."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651358
    m_Localized: Kaspi rurashkakuna
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651359
    m_Localized: "Tiyarinakuna, Patakukuna shinallatak consola nishkakunapash rirpu
      shinallatak marmolwampash Neptal\xED Mart\xEDnez Jaramillo taytami llamkashka."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651360
    m_Localized: Consola Francesa
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651361
    m_Localized: 'Shinallatak Consola Francesa kuriwan nishkaka, rirpuwan shinallatak
      rumikunawampashmi rurashkakuna.

'
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651362
    m_Localized: Iran mamallaktamanta Puntukuna
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651363
    m_Localized: "Kay Puntukunaka antapi rurashkami kan, Isfah\xE1n nishkapimi makiwan
      tullpushkakunami, Minakari yachaywan paktachishkakuna."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651364
    m_Localized: Corea mamallaktamanta Puntukuna
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651365
    m_Localized: "Dinast\xEDa Goryeo nishkapami kan, chunka ishkay patsakyarishka
      watapi. "
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651366
    m_Localized: Puntu
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651367
    m_Localized: Ankas tullpupi rurashka shinallatak waylla tullpupipash ruraskami
      kan.
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651368
    m_Localized: Llaksa achikkuna
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651369
    m_Localized: <i>Libertas</i> Apunchik Romanatami riksichin, ashtawanpacha Kishpirishka
      kawsayta. Llaksapi rurashkami kan, Tukuy ukkupa Llakllakamashkami kan.
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651370
    m_Localized: Pataku
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651371
    m_Localized: "Chawpipika hatun suni pataku shinallatak tiyarinakupashmi tiyanakun,
      kaykunataka Juan Bautista Minghetti Italia mamallaktamanta Llakllakamayuk shinariyanka
      ninkunami, Caama\xF1o \xD1awpakman Pushak pachapi. Kaykunataka Salesianos Escuela
      de Artes y Oficios yachana wasipimi rurashkakuna. Kallaripika Salas legislativas
      nishkakunapakmi kashkakuna. Uma tiyarinapika \xD1awpakman Pushakmi Tiyarin,
      paypa tiyarinaka escudo nacional unanchawanmi rurashkakan."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651372
    m_Localized: Artesonado
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651373
    m_Localized: "Artesonado nishkaka Ra\xFAl Robalino Llakllakamayukmi, cedro yurawan
      rurashka, kaypika ishkay hatun achikkunami warkuriyanakun. Kay achikunaka salas
      legislativas nishkakunapakmi kashkakuna, waranka iskun patsak sukta chunka
      watapimi allichishkakuna."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651374
    m_Localized: "<b>Z\xF3calo</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651375
    m_Localized: "Z\xF3calo kaspiwan rurashkaka Vicente Arboleda llakllakamayukmi
      rurashka. \n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651376
    m_Localized: Tapiz
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651377
    m_Localized: Shinallatak Guangopolo kitillipimi Tapiz awashkataka pirkakunapi
      llutashkakuna.
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651378
    m_Localized: "<b>Virgen con el Ni\xF1o</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651379
    m_Localized: "Aklla Mama wawawan\nMana Riksishka\n\xD3leo sobre lienzo\nChunka
      kanchis patsakyarishka\nColecci\xF3n Museo Nacional, Ministerio de Cultura
      y Patrimonio"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651380
    m_Localized: <b>Artesonado</b>
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651381
    m_Localized: "Artesonado nishkaka Miguel \xC1ngel Tejada llakllakamayukpa llamkaymi
      kan."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651382
    m_Localized: 'Kaspi rurashkakuna '
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651383
    m_Localized: "Tukuylla Mobiliario nishkakunaka Salom\xF3n Enr\xEDquez shinallatak
      V\xEDctor Mogoll\xF3n llakllakamayukkunapa llamkashkakunami kan, ashtawanpacha
      Waranka iskun patsak sukta chunka watapi mushukyachishkapi."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651384
    m_Localized: "Z\xF3calo"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651385
    m_Localized: "Tukuylla Mobiliario nishkakunaka Salom\xF3n Enr\xEDquez shinallatak
      V\xEDctor Mogoll\xF3n llakllakamayukkunapa llamkashkakunami kan, ashtawanpacha
      Waranka iskun patsak sukta chunka watapi mushukyachishkapi."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651386
    m_Localized: <b>Pedro Vicente Maldonado (1704-1748)</b>
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651387
    m_Localized: "Enrique G\xF3mezjurado \n\xD3leo sobre lienzo \nA\xF1o 1936\nColecci\xF3n
      reserva Alberto Mena Caama\xF1o - Centro Cultural Metropolitano de Quito\n\nAllpamamayachak
      shinallatak Allpashuyuyachak, Riobamba llaktapi wacharishka shinallatak Londres
      llaktapi wa\xF1ushka.\nQuito llaktamanta Esmeraldas llaktakaman \xF1anta kallarichishka
      shinallatak \u201Cmuyunti Quito markapi killkashka pankata kallarichishka\u201D,
      Par\xEDs llaktapi rurashka tullpuk shuyushkami kan, ashtawanpacha Carlos Mar\xEDa
      de la Condamine paypa mashimi waranka kanchis patsak pichka chunka watapi rurachishka
      kan. Par\xEDs llaktapa Academia de Ciencias tantanakuypi paktami karka shinallatak
      Londres llaktapipash Real Academia Geogr\xE1fica tantanakuypipash paktami kashka.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651388
    m_Localized: "<b>Francisco Jos\xE9 de Caldas (1768-1816)</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651389
    m_Localized: "An\xF3nimo\n\xD3leo sobre lienzo \nSiglo XX \nColecci\xF3n reserva
      Alberto Mena Caama\xF1o - Centro Cultural Metropolitano de Quito\n\nAllpamamayachak,
      chaskayachak, Pachamamayachak shinallatak Abya yala llaktapa kuyakpash. Payka
      Sisakunamanta taripaykunata rurashka, chay llamkaykunapi Quito llaktapi Mutis,
      Humboldt shinallatak Bonpland runakunata riksishkakuna. \u201CPaypa kawsaykunata 
      kay Viaje Puriy killkashkakunapi riksichirkakuna: Ashtawanpacha Quito llaktamanta
      Pac\xEDfico hatun kuchaman purishpa, Sitwa shinallatak karwa killakunapi kay
      waranka pusak patsak kimsa watapi\u201D, Shinallatak \u201CViaje al coraz\xF3n
      de Barnuevo\u201D killkashkakunapipash riksichishkakunapash.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651390
    m_Localized: <b>Eugenio Espejo (1747-1795)</b>
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651391
    m_Localized: "Murgueitio\n\xD3leo sobre lienzo \nSiglo XX\nColecci\xF3n Reserva
      Alberto Mena Caama\xF1o \u2013 Centro Cultural Metropolitano de Quito\n\nQuito
      llaktamanta Hampik Yachak, Kamachikyachak shinallatak killkakyachakpash, Kishpirishkamanta
      kallarik llamkak tayta.\nPaypa killkashkakunaka kaykunami kan: \u201CPrimicias
      de la cultura de Quito\u201D Waranka kachis patsak iskun chunka ishkay Audiencia
      llaktapa  kallarik killkashka panka, Shinallatak \u201CSociedad Patri\xF3tica
      de amigos del pa\xEDs de Quito\u201D wi\xF1achishka kan, kay killkashkakunawanmi 
      conciencia nacional quite\xF1a yuyayta wi\xF1achishkakuna.\n\nPushakkunata
      mana alli kachimanta, sinchi shayarishkamanta, katitukushka shinallatak wichaytukushkapash
      karka, Quito llaktapi, kapak killapi waranka kanchis patsak iskun chunka pichka
      watapi wa\xF1ushka.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651392
    m_Localized: "<b>Manuela Ca\xF1izares</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651393
    m_Localized: "An\xF3nimo\n\xD3leo sobre lienzo\nSiglo XIX\nColecci\xF3n Reserva
      Alberto Mena Caama\xF1o - Centro Cultural Metropolitano de Quito\n\nKishpiriy
      pachapika warmikunapa ayninakuyka ninan sumak allimi karka. Kay llaki kawsaykunapika,
      paykunapa pachakunata kushpa, alli shutita kushpa, tukuy charishkakunata kushpa
      shinallatak kawsaytapash kushpapash yanapashkakuna.\n\nMama Manuela Ca\xF1izares,
      llaktapi hatun rimarikunapika, kushichin kana kashka Amawtay Hatun Yachana
      Wasi chimpapurapi. Chay tantanakuykunapika umayuk shinallatak Mamallaktata
      kuyakkunapash tantarin kana kashka, chaymantami chunka punchapi, karwa killapi,
      waranka pusak patsak iskun watapi, tutamanta pachapi Espa\xF1ol Pushakkunata
      chikanyachishkakuna. \n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966343651394
    m_Localized: "<b>Libertador Sim\xF3n Bol\xEDvar (1783-1830)</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845632
    m_Localized: "V\xEDctor Mideros \n\xD3leo sobre lienzo \nSiglo XX\n\nVenezuela
      Mamallaktamanta Awka Runa shinallatak Kapaktukuk, Espa\xF1olkuna llakichik
      pachakunapi kishpichishka, ashtawanpacha Venezuela, Colombia, Panam\xE1, Ecuador,
      Per\xFA shinallatak Bolivia mamallaktakunata.\nPushak, Mamallaktamanta hawa
      yachak, shinallatak Atikrunapash, Tawaintisuyupika ninan riksirishka kan. Paypa
      yachaykunaka kishpirishka mamallaktakunapika hatun karullaktakunamanmi chayankuna.\n\nWaranka
      pusak patsak chunka iskun watapika Colombia mamallaktata wi\xF1achirka, ashtawanpacha
      chusku kallarik mamallaktakunawan. Waranka pusak patsak kimsa chunka watakamanmi
      \xF1awpakman pushak karka, chay kipaka llakta ukukunapi rakirikunamantaka llakipi
      urmarka, shinallatak  pushak kaytapash chinkachirka, ashtawanpacha shuk shuk
      pushakkuna rikurishkamanta, chaymantami Pushak kayta sakirka. Shuk llaktaman
      rikushpa, Chunka kanchis punchapi, kapak killapi, waranka pusak patsak kimsa
      chunka watapi wa\xF1urka.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845633
    m_Localized: "<b>Alegor\xEDa de Manuela S\xE1enz (1797-1856)</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845634
    m_Localized: "An\xF3nimo\n\xD3leo sobre lienzo \nSiglo XX\nColecci\xF3n reserva
      Alberto Mena Caama\xF1o - Centro Cultural Metropolitano de Quito\n\nEcuador
      mamallaktapa kishpiriy pachapi Atikruna warmi, Sim\xF3n Bol\xEDvarpa Ninan
      kuyashka shinallatak yanapak warmi. Lima llaktapi Abyayalamanta makanakuyta
      kallarirka, chay ruraykunamantami payta shinallatak shuk warmikunatapash allikachirkakuna.\n\nSim\xF3n
      Bol\xEDvar taytaka, Quito llaktaman chaymukpimi raymi killapi, waranka pusak
      patsak ishkay chunka ishkay watapimi riksishka, chaymantami paypa yanapak mashi
      tukushka. Kay ishkay chunka pusak punchapi, kuski killapi, kay waranka pusak
      patsak ishkay chunka pusak watapi, tuta pachakunapi Sim\xF3n Bol\xEDvar taytata,
      paypa kawsayta kishpichishka, chay pachamantami Bol\xEDvar taytaka \u201CKishpichikta
      Kishpichishka\u201D shutichishka.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845635
    m_Localized: "<b>Antonio Jos\xE9 de Sucre (1795-1830)</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845636
    m_Localized: "Emilio Moncayo\n\xD3leo sobre lienzo \nSiglo XX\n\nVenezuela mamallaktamanta
      Awka runa, Mamallaktamanta hawa yachak, Kapaktukuk shinallatak Abya Yala Mamallaktakunata
      kishpichikpash karka. Kay ishkay chunka chusku punchapi, aymuray killapi, waranka
      pusak patsak ishkay chunka ishkay watapi,  Pichincha makanakuypimi mishashka,
      \xD1awpa Audiencia de Quito hatun llaktata kishpichirka. Iskun punchapi, kapak
      killapi, waranka pusak patsak ishkay chunka chusku watapi, Ayacucho llaktapi,
      Per\xFA Mamallaktata kishpichirka, chaypimi Gran Mariscalta shutichishka.\n\nBolivia
      Mamallaktapa Kallarik Pushakta shutishka, karwa killapi, waranka pusak patsak
      ishkay chunka pusak watapi, pushak kayta sakirka, ashtawanpacha Quito llaktapi,
      paypa Quito llaktamanta Mar\xEDa Carcel\xE9n warmiwan kawsankapak. Kay chusku
      punchapi, raymi killapi, waranka pusak patsak kimsa chunka watapi, Berruecos
      urkukunapi, Pasto llaktapi, Colombia mamallaktapa shinallatak Kishpichik taytapa
      pi\xF1anakuk runakuna, wa\xF1uchirka.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845637
    m_Localized: "<b>Juan Jos\xE9 Flores (1800-1864)</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845638
    m_Localized: "Marco Salas\n\xD3leo sobre lienzo \nSiglo XX\n\nKishpichik Awkakanchapa
      hatun awka runa shinallatak Venezuela mamallaktamanta kapaktukukpash. Bol\xEDvar
      taytapa sumak mashi, kullasuyu Colombia mamallaktapa intendente pushakta shutichishka,
      shinallatak Gran Colombia mamallakta tukuriypachapi Waranka pusak patsak kimsa
      chunka watapi, Ecuador Mamallaktapa kallarik pushaktapash shutichiy tukushka.
      Kay Waranka pusak patsak chusku chunka kimsa wata- waranka pusak patsak chusku
      chunka pichka watapi, kati pushak pachapika, Kapakapuk wasitaka neocl\xE1sico
      nishkawan mushukyachirka. Waranka pusak patsak chusku chunka pichka watakaman
      apuktukuk pachata \xF1awpakman aparka, ashtawanpacha shuk hatun shayarikuna
      paktarishkakaman, chay pachapimi shitay tukurka, shinallatak kanchamanta awka
      runakunata charishkamanta.\n\nAlli tukushka kipaka, Pushak Garc\xEDa Moreno
      taytapa yanapak tukurka, Pushakta yanapakuymanta ashtawanpacha shayarikunata
      harkakuymanta wa\xF1uyta tarirka. \n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845639
    m_Localized: <b>Vicente Rocafuerte (1783-1847)</b>
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845640
    m_Localized: "V\xEDctor Mideros \n\xD3leo sobre lienzo \nSiglo XX\n\nKawsay sapita
      yachak runa, Wamra kay pachapi, Europa mamallaktakunapi yachakushka. Cortes
      de C\xE1diz tantanakuypa Diputado akllay tukushka, kipamanka Diplom\xE1tico,
      M\xE9xico mamallaktapa yanapak tukurka.\n\nKay waranka pusak patsak kimsa chunka
      kimsa watapi, Ecuador mamallaktapa, congreso tantanakuypa Diputado tukurka,
      General Flores Awka pushak runapa, Pi\xF1ak mashi tukurka, kipamanka Ecuador
      mamallaktapa ishkay nikipi pushak akllay tukushka, Yachakuymanta, kullkikamaymantapash
      llamkak Pushak. Kutinlla Flores taytata chimpapuraypika mamallaktamanta llukshirka,
      chay kipami Lima llaktapi wa\xF1urka.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845641
    m_Localized: "<b>Gabriel Garc\xEDa Moreno (1821-1875)</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845642
    m_Localized: "V\xEDctor Mideros\n\xD3leo sobre lienzo\nSiglo XX\n\nWaranka pusak
      patsak sukta chunka shuk wata, waranka pusak patsak sukta chunka pichka wata,
      waranka pusak patsak sukta chunka iskun wata shinallatak waranka pusak patsak
      kanchis chunka pichka watakunapi Pushak tukushka. Ecuador mamallaktapi kay
      Apuktukuk pachakunapika ninan riksirishkami karka. Apunchikpa yachaykunata
      sinchiyachinkapakmi mashkarka, ashtawanpacha paypa yuyaypika mana chay yachaykunata
      paktachikpika, mamallaktaka mana \xF1awpakman riyta ushankachu nishpa.\n\nKullkikamayta
      shinallatak Kamachikkamaytapash hampirka. Yachakuykunata hatunyachirka. Sumakrurakta
      shinallatak Amawta yachaykunatapash kallarichirka. Hatun llamkaykunawan, mamallaktata
      mushukyachirka, antaru \xF1anta llamkayta kallarichirka Guayaquil Llaktamanta,
      Quito Llaktakaman. Kay Pushak pachakunapika mana pitapash uyankapakka munarka,
      shinallatak llakichikunatapash paktachirka, chaymantami tawka Pi\xF1ak mashikunata
      tarishka. Sukta punchapi, karwa killapi, waranka pusak patsak kachis chunka
      pichka watapi wa\xF1uchirka ashtawanpacha kimsa niki pusak tukuna pachakunapi.\n\nIshkay
      pushak pachakunapika, kapakapuk wasitaka hatun mushukyachik llamkaykunata paktachichirka,
      ashtawanpacha allpamama kuyurishka kipa, kay waranka pusak patsak pichka chunka
      iskun watapi shinallatak waranka pusak patsak sukta chunka pusak watakunapi.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845643
    m_Localized: "<b>Antonio Flores Jij\xF3n (1833-1915)</b>\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845644
    m_Localized: "Atahualpa Villacr\xE9s \n\xD3leo sobre lienzo \nSiglo XX\nColecci\xF3n
      Reserva Alberto Mena Caama\xF1o - Centro Cultural Metropolitano de Quito\n\nMamallakta
      hawa yachak, Kanchaman Mamallaktata alli rikuchik yachak shinallatak Yachachik
      yachak. Juan Jos\xE9 Flores taytapa churi, Ashtawanpacha kallarik Ecuador mamallaktapa
      pushak. Europa mamallaktakunapi yachakushka. Ecuador mamallaktata allita rikuchirka
      Kay Estados Unidos, Francia, Inglaterra shinallatak Colombia mamallaktakunapi.
      Kay waranka pusak patsak pusak chunka pusak watapi shinallatak waranka pusak
      patsak iskun chunka ishkay watakunapi Pushak kayta paktachirka, Apunchik yachaywan,
      yachakuykunata, llamkaykunata, kawsay sapi yachaykunatapash yanaparka. Waranka
      pusak patsak iskun chunka pichka watapi, R\xE9gimen Liberal pachakuna chayamukukpi,
      Europa mamallaktakunaman llukshirka, chaypimi wa\xF1urka."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845645
    m_Localized: <b>Campamento en la plaza Grande, 16 chunka sukta punchapi 1868
      waranka pusak patsak sukta chunka pusak watapi, Allpamama kuyurishka kipa</b>
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845646
    m_Localized: "An\xF3nimo\n\xD3leo sobre lienzo\nSiglo XIX\nColecci\xF3n Reserva
      Alberto Mena Caama\xF1o - Centro Cultural Metropolitano de Quito\n\nKay Chunka
      sukta punchapi, karwa killapi, waranka pusak patsak sukta chunka pusak watapi,
      shuk hatun allpamama kuyuriy paktarirka, Ibarra llaktata tukuchirka shinallatak
      chinchaysuyupika shuk shuk mamallaktapa llaktakunata llakichirkakuna, ashtawanpacha
      chunka pichka waranka wa\xF1uykunami tiyarka. Quito llaktapipash, kay Apunchikpa
      wasikunata, shuk shuk wasikunata shinallatak Kapakapuk wasitapash llakichirkakuna.
      Alllpamama kuyuykunaka tawka hunkaykunami karka, llaktakunapi kawsakkunaka
      mancharirkakuna, chaymantami samana pampakunapi uchilla wasilayakunata shayachirkakuna
      ashtawanpacha pu\xF1unakukpi ama wa\xF1uyta tarinkapak.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845647
    m_Localized: Amatista Rumi
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845648
    m_Localized: "Amatista rumika Uruguay mamallaktamantami kan sumak maywa tullpumi
      rikurin, allpapachapi rikushpaka ninan all\xEDkachishkami kan."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845649
    m_Localized: Puntu
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845650
    m_Localized: "Li Ruogumi karashka, Exim Bank ukuta \xF1awpakman pushak.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845651
    m_Localized: Patakukuna
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845652
    m_Localized: Hatun kichiki Pataku, punta Kapakapukpa wasimanta. Esfinges shinallatak
      Leones alados nishkakutatami charinkuna.
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845653
    m_Localized: Shayachinkapak kuska
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845654
    m_Localized: 'Kaspipi rurashkami kan, Kuri antawan chapushpa. '
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845655
    m_Localized: Limoges mulukuna
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845656
    m_Localized: "Mulukuna porcelanawan rurashkakunami kan, Juan Jos\xE9 Flores \xF1awpakman
      pushak taytapa Mercedes Jij\xF3n warmi tiyami Casa de Limoges Francia mamallaktamanta
      apamuchun minkashka. Kay Mulukunapika kallariy escudo de armas de la Rep\xFAblica
      unanchata shinallatak ishkay urkukunatapash, shuk intitapash makiwan tullpushkakuna."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845657
    m_Localized: <b>Kapakapukpa Mulukuna</b>
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845658
    m_Localized: "Waranka iskun patsak sukta chunka watapi Kapakapuk wasimanka cubierto,
      vajilla de cristal y porcelana nishkakunatami kushka, shinallatak pintukunatapash
      kushkakuna, ashtawanpacha Purhardt (Inglaterra), Christofle y Baccarat (Francia)
      y Ascen\xE7ao (Portugal) mamallaktakunamanta apamushkakuna.\nCuberter\xEDa,
      Copas de Cristal de Baccarat y piezas de vajilla nishkakunatapash upyankapapash
      apamushkakuna waranka pusak patsak sukta chunka watapi.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845659
    m_Localized: Retablo
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845660
    m_Localized: "Shinallatak wakin alli kaspikunatami churarkakuna, ashtawanpacha
      kaspi llakllashka policromadas quite\xF1as nishkakunata Inmaculada Concepci\xF3n,
      San Joaqu\xEDn shinallatak Santa Ana, kay chunka pusak patsakyarishka pachakunapi,
      Museo Nacional wasipa."
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845661
    m_Localized: "Virgen Inmaculada Concepci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845662
    m_Localized: "Mana riksishka\nEscultura kaspipi llakllashka shinallatak policromada
      rurashka.\nChunka pusak patsakyarishka pacha\nColecci\xF3n Museo Nacional,
      Ministerio de Cultura y Patrimonio\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845663
    m_Localized: Santa Ana
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845664
    m_Localized: "Mana riksishka\nEscultura kaspipi llakllashka shinallatak policromada
      rurashka.\nChunka pusak patsakyarishka pacha\nColecci\xF3n Museo Nacional,
      Ministerio de Cultura y Patrimonio\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845665
    m_Localized: "San Joaqu\xEDn "
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845666
    m_Localized: "Mana riksishka\nEscultura kaspipi llakllashka shinallatak policromada
      rurashka.\nChunka pusak patsakyarishka pacha\nColecci\xF3n Museo Nacional,
      Ministerio de Cultura y Patrimonio\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845667
    m_Localized: '<b>Tiyarinapa aklla Mama</b>

'
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845668
    m_Localized: "Rafael Troya (atribuido)\n\xD3leo sobre lienzo\nChunka iskun patsakyarishka
      pacha\nColecci\xF3n Museo Nacional, Ministerio de Cultura y Patrimonio\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845669
    m_Localized: "<b>San Jos\xE9 y el Ni\xF1o</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845670
    m_Localized: "Rafael Troya (atribuido)\n\xD3leo sobre lienzo\nChunka iskun patsakyarishka
      pacha\nColecci\xF3n Museo Nacional, Ministerio de Cultura y Patrimonio\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845671
    m_Localized: 'Cristo crucificado

'
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845672
    m_Localized: "Mana Riksishka\nEscultura Kaspipi llakllashka, shinallatak encarnada
      policromadapash rurashka\nChunka pusak patsakyarishka pacha\nUrna ukupi llakllashka
      \nColecci\xF3n Museo Nacional, Ministerio de Cultura y Patrimonio\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845673
    m_Localized: 'Campanario kayachik shinallatak Pachachik

'
    m_Metadata:
      m_Items: []
  - m_Id: 6903966347845674
    m_Localized: "Gabriel Garc\xEDa Moreno Kapakapuk pachapimi chawpi Wasi shayakuktaka
      shayachishkakuna, pachachik shinallatak campanas kayachik nishkakunatapash
      Jer\xF3nimo Carri\xF3n 1865 waranka pusak patsak sukta chunka pichka watamanta
      shinallatak 1867 waranka pusak patsak sukta chunka kanchis watakaman churarkakuna.
      \n\nFrontispicio Pachachik Carondelet Kapakapuk wasipa mana llamkakurkachu,
      wa\xF1ushka shinami karka, ishkay waranka ishkay chunka pichka watapi, Daniel
      Noboa \xD1awpakman Pushak pachapimi allichishkakuna shinallatak llamkachita
      kallarichirkakuna.\n\nHawa wasipika Ecuador mamallaktapa unanchatami pawaychinkuna,
      Awaki punchamanta. Kanchis Tutamanta pichka chishi pachakaman, chaska punchakaman;
      kutin samana punchakunapika pusak tutamanta pachamanta pichka chishi pachakaman.\n\n"
    m_Metadata:
      m_Items: []
